{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "locus-durable-object",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOCUS_STORE",
        "class_name": "LocusStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LocusStore"]
    }
  ]
}
